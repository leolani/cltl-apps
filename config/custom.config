# Override settings from default.config here. This file is shared by every
# stack — servers/* and clients/* alike — so only put CROSS-CUTTING changes
# here (e.g. a platform-wide ASR model change). A change that applies to one
# stack's role only (the storage vs. host-mic-proxy split of [cltl.backend],
# or a tenant id) belongs in that stack's own config/custom.config instead —
# see doc/DEPLOYMENT.md.
#
# Only add the sections and keys you want to change — everything else falls
# through to default.config.

# Example: switch ASR to Google Cloud Speech (requires a service-account key)
# [cltl.asr]
# implementation: google

# [cltl.asr.google]
# language: en-US

# Example: change the Whisper model size (tiny / base / small / medium / large)
# Larger models are more accurate but slower and use more memory.
# [cltl.asr.whisper]
# model: small
# language: en

# Example: tune Voice Activity Detection sensitivity
# activity_threshold: 0.0 (most sensitive) – 1.0 (least sensitive)
# All time values are in milliseconds.
# [cltl.vad.webrtc]
# activity_threshold: 0.6
# activity_window: 300
# allow_gap: 300
# padding: 600
