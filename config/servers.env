# Docker Compose variables for servers/* stacks.
#
#   docker compose --env-file config/servers.env \
#       -f servers/broker/docker-compose.yml \
#       -f servers/eliza/docker-compose.yml \
#       -f servers/vad-asr/docker-compose.yml \
#       -f servers/emissor/docker-compose.yml up -d --wait
#
# Nothing here is required — every servers/* image tag already defaults to
# :latest — this file exists so pinning a version is one edit instead of an
# inline env var on every command.

# VERSION=latest
