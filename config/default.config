# Shared defaults for every stack in this deployment — servers/* and
# clients/* alike. Every stack bind-mounts THIS file read-only as its own
# config/default.config, so a topic or platform-wide default only needs to be
# changed here once.
#
# Two exceptions are deliberately NOT decided here, because the "right" value
# depends on which container is reading it:
#   - [cltl.backend]: the baseline below is the STORAGE role servers/eliza
#     runs (`storage_main.py`). clients/backend plays a different role (it
#     proxies the host microphone/camera server instead of holding the
#     store), so it overrides this whole section in its own
#     clients/backend/config/custom.config.
#   - [cltl.event.kombu] tenant: left blank here — every servers/* stack is
#     shared across every tenant and must stay untenanted. Each clients/*
#     stack sets it to $CLTL_TENANT in its own config/custom.config. See
#     doc/DEPLOYMENT.md and custom-module/docs equivalents for why an
#     untenanted publish and a tenanted subscriber silently fail to meet.
#
# All services now sit on one Docker network (see servers/broker), so
# hostnames below (rabbitmq, eliza-backend) resolve for every stack directly
# — no host.docker.internal indirection needed except for the host-side
# microphone/speaker server, which is not, and cannot be, in Docker.

[cltl.audio]
sampling_rate: 16000
channels: 1
sample_depth: 2
frame_size: 480

audio_resource: cltl.backend.resource.audio
mic_resource: cltl.backend.resource.microphone

[cltl.video]
resolution: VGA
camera_index: 0

[cltl.backend]
run_server: False
storage_url: http://eliza-backend:8000/storage/
audio_storage: local
audio_storage_path: ./storage/audio
audio_source_buffer: 16
image_storage: local
image_storage_path: ./storage/image
image_cache: 32
scenario_topic: cltl.topic.scenario

[cltl.backend.remote_storage]
storage_url: http://eliza-backend:8000/storage
upload_timeout: 30

[cltl.backend.mic]
topic:

[cltl.backend.image]
topic:
rate: 0

[cltl.backend.tts]
topic: cltl.topic.text_out

[cltl.backend.text_output]
remote_url:

[cltl.chat-ui]
name: chat-ui
agent_id: leolani
external_input: True
timeout: 0

[cltl.chat-ui.events]
local: True
topic_utterance: cltl.topic.text_in
topic_response: cltl.topic.text_out
topic_scenario : cltl.topic.scenario

[cltl.intentions.init]
topic_scenario: cltl.topic.scenario
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_text_in: cltl.topic.text_in
topic_text_out: cltl.topic.text_out
topic_face:
greeting: Do you want to talk to me?

[cltl.bdi]
topic_scenario: cltl.topic.scenario
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
model: {"init":
             {"initialized": ["eliza"]},
         "eliza":
             {"quit": ["init"]}
         }

[cltl.context]
topic_scenario: cltl.topic.scenario
topic_speaker: cltl.topic.scenario_speaker
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_knowledge:
start_scenario: true

[cltl.vad]
implementation:
mic_topic: cltl.topic.microphone
vad_topic: cltl.topic.vad

[cltl.vad.webrtc]
activity_window: 300
activity_threshold: 0.8
allow_gap: 300
padding: 600

[cltl.asr]
implementation: whisper
sampling_rate: 16000
vad_topic: cltl.topic.vad
asr_topic: cltl.topic.text_in

[cltl.asr.google]
sampling_rate: 16000
language: en-GB
hints:

[cltl.asr.whisper]
model: base
language: en

[cltl.asr.wav2vec]
model: jonatasgrosman/wav2vec2-large-xlsr-53-english

[cltl.asr.speechbrain]
model: speechbrain/asr-wav2vec2-commonvoice-en

[cltl.eliza]
language: en
topic_input : cltl.topic.text_in
topic_output : cltl.topic.text_out

[cltl.keyword]
intentions: eliza
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_text_in: cltl.topic.text_in
topic_text_out: cltl.topic.text_out

[eliza.context]
topic_scenario: cltl.topic.scenario
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire

[cltl.event]
implementation: kombu
log_dir: ./storage/event_log

[cltl.event.kombu]
server: amqp://eliza:eliza123@rabbitmq:5672/
exchange: cltl.combot
compression: bzip2
tenant:

[cltl.emissor-data]
path: ./storage/emissor

[cltl.emissor-data.event]
topics: cltl.topic.scenario,
        cltl.topic.image, cltl.topic.microphone,
        cltl.topic.text_in, cltl.topic.text_out,
        cltl.topic.vad,
        cltl.desire, cltl.intention

[environment]
GOOGLE_APPLICATION_CREDENTIALS: config/google_cloud_key.json
