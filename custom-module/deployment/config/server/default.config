# The SHARED, UNTENANTED half of the deployment: one broker, one cltl-eliza,
# every tenant.
#
# CLTL_TENANT is empty here, so KombuEventBus binds `cltl.topic.text_in.#` —
# `#` matches zero or more words, so this single ELIZA hears every tenant's
# utterances. Its reply is built with source=event, which copies the tenant
# across (Event.with_source), and an untenanted bus routes on the EVENT's
# tenant rather than its own (cltl.combot.infra.event.kombu.KombuEventBus.publish)
# — so the answer lands back in the one tenant that asked, and in no other.
# Those two rules are the whole reason a shared server works at all; the design
# documentation for them is the header of
# cltl-dev/integration/config/topologies/multitenant_server.config.
#
# The [cltl.event.kombu] block below is BYTE-IDENTICAL to the tenant half's.
# Only the environment differs. That is the entire multi-tenancy mechanism.
#
# There is no [cltl.context], [cltl.bdi], [cltl.intentions.init] or
# [cltl.keyword] anywhere in this deployment: the custom side opens the
# scenario. A module a deployment does not run gets no section at all, rather
# than a disabled one. See docs/tenancy.md.

[cltl.event]
implementation: kombu

[cltl.event.kombu]
server: $CLTL_AMQP_URL
exchange: cltl.combot
compression: bzip2
# Empty: this half serves every tenant. server.compose.yml sets CLTL_TENANT
# explicitly to "" rather than leaving it undefined — an undefined variable is
# passed through as the literal string "$CLTL_TENANT" with only a warning, and
# the bus would then bind a queue nothing ever routes to.
tenant: $CLTL_TENANT

[cltl.eliza]
language: en
topic_input: cltl.topic.text_in
topic_output: cltl.topic.text_out
# All three empty, and all three deliberate.
#
# UNGATED, because TopicWorker._check_intention keeps ONE process-global active
# flag and never reads event.metadata.tenant — so a shared module gated on an
# intention is switched on and off by whichever tenant spoke last. Pinned
# upstream as a known defect by
# integration/tests/slices/test_intention_routing.py::TestTenantScopedGating.
#
# topic_intention emptied as well, because ungating alone is not enough:
# ElizaService.start still subscribes to a non-empty intention topic, which on
# an untenanted bus means `cltl.topic.intention.#` — every tenant's BDI traffic
# arriving on one queue.
#
# Emptying them also makes ElizaService's greeting branch unreachable, which
# matters: that branch publishes with NO source=, so its greeting would carry
# no tenant and be delivered to nobody.
intentions:
topic_intention:
topic_desire:
