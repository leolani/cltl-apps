# The deployment every service in deployment.compose.yml reads.
#
# One file, mounted read-only over each image's own config/ directory, exactly
# as a real deployment does it: every platform image ships a config/ using
# LEGACY topic names (cltl.mic, cltl.chat.utterance) meant for standalone
# `python src/main.py` runs, and a deployment that lets those defaults stand
# comes up perfectly healthy and wired to nothing. The canonical cltl.topic.*
# names below are what actually connects the modules to each other.
#
# Derived from integration/config/{base,tier-compose}.config plus the
# text_pipeline topology in the cltl-dev repository, flattened into one file
# and reduced to the four modules a text conversation needs. Everything about
# audio (backend, vad, asr) is left out rather than disabled: a module this
# deployment does not run needs no section at all.

[cltl.event]
implementation: kombu

[cltl.event.kombu]
server: $CLTL_AMQP_URL
exchange: cltl.combot
compression: bzip2
# Empty: this is a single-tenant deployment. cltl-example warns once at
# startup that it is bound to every tenant's events, which is correct here and
# wrong on a shared bus — see docs/tenancy.md.
tenant: $CLTL_TENANT

[cltl.chat-ui]
name: chat-ui
agent_id: leolani
external_input: True
timeout: 0
image_upload: False
image_cache: 4
image_max_size: 10485760
image_types: image/png, image/jpeg, image/gif, image/webp
image_storage_url:
image_upload_timeout: 30
monitoring_url:

[cltl.chat-ui.events]
local: True
topic_utterance: cltl.topic.text_in
topic_response: cltl.topic.text_out
topic_scenario: cltl.topic.scenario
topic_image:

[cltl.eliza]
language: en
topic_input: cltl.topic.text_in
topic_output: cltl.topic.text_out
# Gated on the `eliza` intention, which BDIService publishes only once the init
# handshake completes — i.e. once you have answered "yes" to the greeting.
# Until then eliza is silent while cltl-example answers immediately, because
# cltl-example does not gate on intentions. See docs/gotchas.md.
intentions: eliza
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire

[cltl.keyword]
intentions:
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_text_in: cltl.topic.text_in
topic_text_out: cltl.topic.text_out

[cltl.intentions.init]
topic_scenario: cltl.topic.scenario
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_text_in: cltl.topic.text_in
topic_text_out: cltl.topic.text_out
topic_face:
greeting: Do you want to talk to me?

[cltl.bdi]
topic_scenario: cltl.topic.scenario
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
model: {"init": {"initialized": ["eliza"]}, "eliza": {"quit": ["init"]}}

[cltl.context]
topic_scenario: cltl.topic.scenario
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_speaker:
topic_knowledge:
# TRUE here, unlike the integration harness, and this is the one setting that
# separates a self-driving deployment from the harness's. The chat UI renders
# nothing until a scenario is open; the harness leaves this false and opens one
# from the test process instead. Nothing is attached here to do that, so the
# context container opens it itself on startup (cltl-context/src/main.py:58).
start_scenario: true
