# ONE TENANT, deployed identically to every tenant.
#
# This file is byte-identical for tenant-a and tenant-b. The only difference
# between two tenants is CLTL_TENANT in the container environment, which
# EnvInterpolation expands into [cltl.event.kombu] tenant below when the value
# is READ rather than when the file is parsed (cltl.combot.infra.config.local).
# Configuration is written once; the tenant arrives from the outside. The same
# point is made at length in the header of
# cltl-dev/integration/config/topologies/multitenant_tenant.config.
#
# The [cltl.event.kombu] block below is BYTE-IDENTICAL to the server half's.
# Only the environment differs. That is the entire multi-tenancy mechanism.
#
# cltl-eliza is deliberately absent: it is the shared module, and it lives on
# the server. cltl-context is absent from BOTH halves — in this template the
# custom side publishes ScenarioStarted/ScenarioStopped itself. Until something
# does, this chat UI renders nothing: ChatUiService._create_payload raises
# `ValueError: No active scenario` on a null scenario id. That blankness is the
# demonstration, not a fault. See docs/tenancy.md.
#
# Extra sections are ignored by whoever does not read them, which is why this
# one file is mounted into chat-ui, cltl-monitoring AND (as custom.config) the
# rung-4 module container. Sharing it is the point: $CLTL_STORAGE_URL is read by
# all three, so the address of the image store cannot drift between them.

[cltl.event]
implementation: kombu

[cltl.event.kombu]
server: $CLTL_AMQP_URL
exchange: cltl.combot
compression: bzip2
# NOT optional here, and not empty. A tenant whose bus has no tenant id is a
# contradiction: it would bind `<topic>.#` and see every other tenant's
# traffic. tenant.compose.yml requires CLTL_TENANT at interpolation time, and
# myorg.tenant refuses to start on an empty or unexpanded value — see
# src/myorg/tenant/service.py.
tenant: $CLTL_TENANT

[cltl.chat-ui]
name: chat-ui
agent_id: leolani
# Required by image_upload below, not merely compatible with it: with
# external_input off, get_utterances defaults its speaker filter to the agent's
# name, which filters the uploaded image's own echo straight back out of the
# transcript. The chat UI's shipped default.config says the same thing the other
# way round, and ships image_upload off because of it.
external_input: True
timeout: 0
# Adds the Image panel beside the conversation: a file input, drag-to-draw
# labelled rectangles, and Submit. Submitting publishes ONE ImageSignalEvent on
# topic_image below and echoes the picture into the transcript — and publishes
# NOTHING on topic_utterance, which is why cltl-eliza never answers a picture
# and an image draws exactly one reply where text draws two.
image_upload: True
image_cache: 4
image_max_size: 10485760
image_types: image/png, image/jpeg, image/gif, image/webp
# Left empty ON PURPOSE: the chat UI falls back to [cltl.backend] storage_url
# below, which is what guarantees that the endpoint it PUTs pixels to is the
# same one everybody else resolves `cltl-storage:` against. Setting it here
# would create a second place for the same address to be wrong in.
image_storage_url:
image_upload_timeout: 30
# The Monitoring tab: an iframe onto the page this tenant's cltl-monitoring
# serves. A browser-reachable URL — see tenant.compose.yml, which builds it from
# the published port. Empty leaves the tab out.
monitoring_url: $CLTL_MONITORING_URL

[cltl.chat-ui.events]
local: True
topic_utterance: cltl.topic.text_in
topic_response: cltl.topic.text_out
topic_scenario: cltl.topic.scenario
# Without this, Submit still echoes the picture into the chat but publishes
# nothing at all — it logs "No image topic configured" and the image never
# reaches this template's module, or cltl-monitoring, or anything else.
topic_image: cltl.topic.image

# One view per scenario of what the platform perceived, served as an annotated
# JPEG and embedded in the chat UI's Monitoring tab. It runs once per tenant
# because it subscribes — and it is OPT-IN (`--profile monitoring`), because
# ghcr.io/leolani/cltl-monitoring is not a published package: it answers
# `unauthorized` where every other image in this deployment pulls anonymously.
# The section stays here, correct and ready, so that enabling the profile is the
# only thing needed. See tenant.compose.yml.
[cltl.monitoring]
topic_scenario: cltl.topic.scenario
topic_image: cltl.topic.image
topic_text_in: cltl.topic.text_in
topic_text_out: cltl.topic.text_out
# Annotations published on their own topic, by cltl-object-recognition and
# cltl-face-recognition. Neither is in this deployment, and an empty value means
# the topic is not subscribed at all — which matters, because TopicWorker would
# otherwise bind a queue on the routing key `.<tenant>`. The regions a person
# drew arrive INSIDE the image signal instead, so the boxes still get drawn.
topic_object:
topic_vector_id:
# 0, not the shipped default of 15. That default is seconds-without-a-request
# after which a scenario stops being recorded, and it exists for a camera-fed
# deployment where decoding frames for nobody is real work. Here images arrive
# one at a time, from a person: one submitted while the interval had lapsed
# would be dropped on arrival, with no replay, leaving the tab permanently blank
# for anyone who was not already looking at it.
active_interval: 0
scenario_cache: 4

# Where `cltl-storage:image/<id>` resolves, for everything on this side that
# reads or writes pixels: the chat UI's upload (via the image_storage_url
# fallback above) and cltl-monitoring's ClientImageSource. The trailing slash is
# part of the value — the reference is resolved with urljoin(), which drops the
# last path segment of a base without one. This template's own module reads the
# same address from [myorg.example] image_storage_url, out of the same
# $CLTL_STORAGE_URL.
[cltl.backend]
storage_url: $CLTL_STORAGE_URL
