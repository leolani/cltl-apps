# A byte-identical copy of deployment/config/server/logging.config, and it has to
# be a real copy rather than a symlink: compose mounts this DIRECTORY over the
# image's /cltl-<name>/config, and a relative symlink would be resolved inside
# the container, where the target does not exist.
[loggers]
keys: root

[handlers]
keys: console

[formatters]
keys: pepperFormatter

[logger_root]
level: DEBUG
handlers: console

[handler_console]
class: StreamHandler
level: NOTSET
formatter: pepperFormatter
args: (sys.stdout,)

[formatter_pepperFormatter]
format: %(asctime)s %(levelname)-8s %(name)-60s %(message)s
datefmt: %x %X



