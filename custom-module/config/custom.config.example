# Copy this to config/custom.config (gitignored — never commit it) to point
# rung 3 at a real deployment's broker instead of the in-process default, as
# one tenant of it.
#
#   cp config/custom.config.example config/custom.config
#   CLTL_AMQP_URL=amqp://leolani:leolani@127.0.0.1:5672/ CLTL_TENANT=tenant-a \
#       CLTL_STORAGE_URL=http://127.0.0.1:8002/storage/ \
#       venv/bin/python src/main.py
#
# CLTL_STORAGE_URL is where `cltl-storage:image/<id>` resolves — the address of
# the deployment's storage service, from OUTSIDE its compose network, with the
# trailing slash. [myorg.example] image_storage_url reads it, and the module
# refuses to start on an empty or unexpanded value while topic_image is set.
# Empty [myorg.example] topic_image in this file instead to run text-only.
#
# CLTL_TENANT is NOT optional and must NOT be empty. This component opens the
# tenant's scenario (see [myorg.tenant] in config/default.config), and an
# untenanted bus publishes on the bare 'cltl.topic.scenario' routing key, which
# no tenanted chat UI binds — the scenario would reach nobody and the chat UI
# would stay blank forever. myorg.tenant refuses to start rather than let that
# happen; set [myorg.tenant] start_scenario to false if something else opens
# the scenario for this tenant.
#
# $VAR interpolation happens at READ time (EnvInterpolation, in
# cltl.combot.infra.config.local), not when this file is parsed. An *unset*
# variable is passed through as the literal string "$CLTL_TENANT" with only a
# logger.warning, and KombuEventBus then treats that literal as a real tenant
# name and binds a real, valid, permanently empty queue. That refusal at
# startup is the only thing standing between you and a deployment that is
# entirely healthy and connected to nothing. See docs/tenancy.md.

[cltl.event]
implementation: kombu

[cltl.event.kombu]
server: $CLTL_AMQP_URL
exchange: cltl.combot
compression: bzip2
tenant: $CLTL_TENANT
