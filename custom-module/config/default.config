# Standalone defaults for `python src/main.py`, i.e. running this component on
# its own with no deployment configuration mounted over it, or inside the
# Docker image (see the Dockerfile: this file ships IN the image, unlike every
# other component's, because a deployment that does not know about this
# template has no [myorg.example] section of its own to supply).
#
# These already use the platform's CANONICAL cltl.topic.* names, unlike the
# LEGACY names (cltl.chat.utterance, cltl.mic) most components' own
# default.config files use for historical reasons — see CLAUDE.md's
# Configuration section. A deployment that mounts this file unmodified is
# therefore correctly wired, not merely "up".

[cltl.event]
implementation: internal

# Everything below this line is what a copier edits. Everything above and
# below the [cltl.event.kombu] section is the platform's own — see
# docs/configuration.md for the boundary.

[myorg.example]
topic_input: cltl.topic.text_in
topic_output: cltl.topic.text_out

# Scenario creation is NOT a feature of this component. It is here only because
# tenant separation requires it: cltl-chat-ui runs inside a tenant, it renders
# nothing and refuses to publish until it has seen a ScenarioStarted, and a
# tenant's ScenarioStarted can only be published on that tenant's own bus. This
# template's deployment runs no cltl-context, so something on the tenant side
# has to open one.
#
# Delete this section, and src/myorg/tenant/, and TenantContainer from
# src/main.py's bases, the day your deployment has a cltl-context of its own.
# Nothing in [myorg.example] refers to any of it. See docs/tenancy.md.
[myorg.tenant]
topic_scenario: cltl.topic.scenario
start_scenario: True
# Seconds to wait before announcing the scenario, so the tenant's chat UI has
# bound cltl.topic.scenario.<tenant> first. KombuEventBus.subscribe returns
# before RabbitMQ has bound the queue, and a topic exchange drops a message
# matching no binding — silently, on both sides. Same reason as the sleep in
# cltl-context/src/main.py, longer because the subscriber is in another compose
# project that `depends_on` cannot order this one against. Raising it costs
# only startup latency. Ignored on an in-process bus, which has no such window.
start_delay: 5.0
# Cosmetic. The chat UI renders these names, so giving two tenants different
# agent names makes the isolation visible on screen. The agent's URI — its
# actual identity — is a constant in src/myorg/tenant/scenario.py and is the
# same for every tenant, because the separation is the routing key and nothing
# else.
agent: Leolani
speaker: Human
location: unknown

[cltl.event.kombu]
server: amqp://localhost:5672
exchange: cltl.combot
compression: bzip2
