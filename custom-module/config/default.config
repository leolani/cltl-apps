# Standalone defaults for `python src/main.py`, i.e. running this component on
# its own with no deployment configuration mounted over it, or inside the
# Docker image (see the Dockerfile: this file ships IN the image, unlike every
# other component's, because a deployment that does not know about this
# template has no [myorg.example] section of its own to supply).
#
# These already use the platform's CANONICAL cltl.topic.* names, unlike the
# LEGACY names (cltl.chat.utterance, cltl.mic) most components' own
# default.config files use for historical reasons — see CLAUDE.md's
# Configuration section. A deployment that mounts this file unmodified is
# therefore correctly wired, not merely "up".

[cltl.event]
implementation: internal

# Everything below this line is what a copier edits. Everything above and
# below the [cltl.event.kombu] section is the platform's own — see
# docs/configuration.md for the boundary.

[myorg.example]
topic_input: cltl.topic.text_in
topic_output: cltl.topic.text_out

[cltl.event.kombu]
server: amqp://localhost:5672
exchange: cltl.combot
compression: bzip2
