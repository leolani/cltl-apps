# The SHARED, UNTENANTED half of the course deployment: one broker, one
# cltl-eliza, every student.
#
# Copied from custom-module/deployment/config/server/default.config and
# UNCHANGED below this header, deliberately. That file's comments explain why
# every value is what it is — the emptied intention topics, the storage-only
# [cltl.backend] block, the missing [cltl.context]. Read it there; it is the
# same reasoning, and duplicating it here would create a second copy to drift.
#
# What differs is not in this file at all. It is the environment: the broker URL
# now carries the administrator's credentials rather than a published password,
# and students connect over TLS with one RabbitMQ user each. See
# server.compose.yml and docs/operator.md.
#
# CLTL_TENANT is empty here, so KombuEventBus binds `cltl.topic.text_in.#` and
# this single ELIZA hears every student. Its reply carries source=event, which
# copies the tenant across, and an untenanted bus routes on the EVENT's tenant —
# so the answer lands back with the student who asked, and nowhere else.

[cltl.event]
implementation: kombu

[cltl.event.kombu]
server: $CLTL_AMQP_URL
exchange: cltl.combot
compression: bzip2
# Empty: this half serves every tenant. server.compose.yml sets CLTL_TENANT
# explicitly to "" rather than leaving it undefined — an undefined variable is
# passed through as the literal string "$CLTL_TENANT" with only a warning, and
# the bus would then bind a queue nothing ever routes to.
tenant: $CLTL_TENANT

[cltl.eliza]
language: en
topic_input: cltl.topic.text_in
topic_output: cltl.topic.text_out
# All three empty, and all three deliberate.
#
# UNGATED, because TopicWorker._check_intention keeps ONE process-global active
# flag and never reads event.metadata.tenant — so a shared module gated on an
# intention is switched on and off by whichever tenant spoke last. Pinned
# upstream as a known defect by
# integration/tests/slices/test_intention_routing.py::TestTenantScopedGating.
#
# topic_intention emptied as well, because ungating alone is not enough:
# ElizaService.start still subscribes to a non-empty intention topic, which on
# an untenanted bus means `cltl.topic.intention.#` — every tenant's BDI traffic
# arriving on one queue.
#
# Emptying them also makes ElizaService's greeting branch unreachable, which
# matters: that branch publishes with NO source=, so its greeting would carry
# no tenant and be delivered to nobody.
intentions:
topic_intention:
topic_desire:

[cltl.backend]
# `local` means CachedImageStorage: a PNG per image under image_storage_path,
# plus a _meta.json. `remote` would make this service a proxy for another one,
# which is not what a store at the bottom of the stack is for.
image_storage: local
image_storage_path: ./storage/image
# Images held in an LRU cache in front of the disk. 32 is cltl-apps/eliza-server's
# number; a conversation in this deployment produces them one at a time.
image_cache: 32
# Nothing in this deployment records audio — no microphone, no ASR. Both keys
# are here because StorageContainer builds BOTH stores when anything asks it for
# `storage_service`, so audio_storage_path has to resolve even though nothing
# will ever be written to it. See deployment/storage/audio/.gitkeep.
audio_storage: local
audio_storage_path: ./storage/audio
audio_source_buffer: 16
