# The operator's copy. `cp .env.example .env` and fill it in; .env is gitignored
# because CLTL_ADMIN_PASS is the broker's administrator password.

# The public DNS name of this host. ONE name, used for both the HTTPS endpoint
# (caddy, 443) and the broker's TLS listener (5671), so there is one certificate
# to obtain and one to renew. It must already resolve to this host before the
# first `up`, or the ACME HTTP-01 challenge fails.
CLTL_HOSTNAME=combot.example.org

# Where Let's Encrypt sends expiry warnings.
CLTL_ACME_EMAIL=course-admin@example.org

# The broker administrator. NOT a student credential and not on any connection
# sheet: students get their own users, created by bin/provision.sh. Generate
# something long, e.g. `openssl rand -base64 30`.
CLTL_ADMIN_USER=combot-admin
CLTL_ADMIN_PASS=

# Pin the platform images for the term. Never `latest`: it moves under you, and
# a mid-term pull that changes a payload dataclass surfaces to students as an
# unmarshal error with no version to point at. Record the tag you chose on the
# connection sheets, since students need the same one for their chat UI.
CLTL_IMAGE_TAG=
