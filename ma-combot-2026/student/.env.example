# Copy this to `.env` and paste in the four values from your connection sheet.
# `.env` holds your password — do not commit it, and do not paste it into chat.

# Your broker URL, with your own username and password, over TLS.
# Keep ?heartbeat=30: without it, closing your laptop lid leaves a queue bound
# on the server until TCP gives up.
CLTL_AMQP_URL=amqps://USER:PASSWORD@combot.example.org:5671/?heartbeat=30

# Your tenant id. This MUST match the TENANT you set in the notebook. A mismatch
# is silent — you type in the chat UI and nothing at all happens.
CLTL_TENANT=

# Where your chat UI uploads image pixels, with your own credentials. The
# trailing slash matters.
CLTL_STORAGE_URL=https://USER:PASSWORD@combot.example.org/storage/

# The platform image tag for this term, from your connection sheet.
CLTL_IMAGE_TAG=

# Only change this if something else on your laptop already uses port 8000.
# CLTL_CHATUI_PORT=8000
