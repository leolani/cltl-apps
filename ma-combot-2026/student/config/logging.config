# Copied from custom-module/deployment/config/tenant/logging.config. It has to
# be a real file rather than a symlink: compose mounts this DIRECTORY over the
# image's /cltl-chatui/config, and a relative symlink would resolve inside the
# container, where the target does not exist.
[loggers]
keys: root

[handlers]
keys: console

[formatters]
keys: pepperFormatter

[logger_root]
level: DEBUG
handlers: console

[handler_console]
class: StreamHandler
level: NOTSET
formatter: pepperFormatter
args: (sys.stdout,)

[formatter_pepperFormatter]
format: %(asctime)s %(levelname)-8s %(name)-60s %(message)s
datefmt: %x %X



