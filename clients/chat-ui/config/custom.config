# What makes this stack a tenant. $CLTL_TENANT is required by this file's
# docker-compose.yml before the container even starts — see
# ../../../doc/DEPLOYMENT.md#tenancy.
[cltl.event.kombu]
tenant: $CLTL_TENANT

# Overrides root ../../config/default.config's [cltl.chat-ui] monitoring_url
# (empty there). $CLTL_MONITORING_URL is set on this stack's docker-compose.yml
# from the caller's environment, defaulting to empty — see
# ../../monitoring/docker-compose.yml.
[cltl.chat-ui]
monitoring_url: $CLTL_MONITORING_URL
