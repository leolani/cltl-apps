# Overrides root ../../config/default.config's [cltl.backend]: that baseline
# is the STORAGE role servers/eliza runs, and this container plays a
# different one — it has no store of its own, it proxies the host's
# microphone/camera server (leoserv) instead. See
# ../../../doc/DEPLOYMENT.md#config-layering.

[cltl.backend]
run_server: False
server_image_url: http://host.docker.internal:8000
server_audio_url: http://host.docker.internal:8000
audio_storage: remote
image_storage: remote

[cltl.backend.mic]
topic: cltl.topic.microphone

[cltl.backend.text_output]
remote_url: http://host.docker.internal:8000
remote_type: sound

# What makes this stack a tenant. $CLTL_TENANT is required by this file's
# docker-compose.yml before the container even starts — see
# ../../../doc/DEPLOYMENT.md#tenancy.
[cltl.event.kombu]
tenant: $CLTL_TENANT
