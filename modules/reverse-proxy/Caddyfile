# The public HTTP surface of a server deployment, routed by path to the three
# HTTP services this platform exposes. AMQP is absent: RabbitMQ terminates
# TLS for it itself, on 5671, with this site's certificate — see the comment
# at the top of ./docker-compose.yml.
#
# One shared Basic Auth credential guards the storage and EMISSOR routes (see
# ./docker-compose.yml for how to generate it). This matches the platform's
# existing tenancy model: separation between tenants is cooperative (a
# routing key), not enforced — so one deployment-wide credential, kept off
# the public internet otherwise, is proportionate. An operator who needs
# per-user credentials can replace the single `import` below with one
# `basic_auth` block per user.
{
	email {$CLTL_ACME_EMAIL}
	acme_ca {$CLTL_ACME_CA}

	# Port 80 is for the ACME HTTP-01 challenge alone, and caddy listens on
	# it only while one runs. What it must NOT do is redirect to 443 — see
	# ./docker-compose.yml.
	auto_https disable_redirects
}

{$CLTL_HOSTNAME} {
	# ---------------------------------------------------------------------
	# The storage API (modules/backend).
	#
	# NOT stripped: the service is already mounted at /storage inside its
	# own container (werkzeug DispatcherMiddleware), so
	# `http://backend:8000/storage/image/x` is the real upstream path
	# and this proxy must pass it through unchanged. `handle`, not
	# `handle_path`, is what makes that so.
	# ---------------------------------------------------------------------
	handle /storage/* {
		basic_auth {
			import /etc/caddy/secrets/basic_auth.auth
		}
		reverse_proxy backend:8000
	}

	# ---------------------------------------------------------------------
	# The EMISSOR data API (modules/emissor). Same
	# already-mounted-at-/emissor shape as storage above.
	# ---------------------------------------------------------------------
	handle /emissor/* {
		basic_auth {
			import /etc/caddy/secrets/basic_auth.auth
		}
		reverse_proxy eliza-emissor:8000
	}

	# ---------------------------------------------------------------------
	# The RabbitMQ management UI (modules/event-bus). `management.path_prefix`
	# in ./rabbitmq.conf is what makes the UI itself work
	# under a path rather than at a host root; without it the page loads and
	# every asset 404s.
	#
	# No basic_auth here, unlike the routes above: the management UI and API
	# authenticate every request with the same Authorization header, carrying
	# the RabbitMQ user's own credential. With caddy demanding the shared one
	# in that header too, no request could ever satisfy both. RabbitMQ's
	# login is the gate instead; tenant users carry no management tag, so
	# only the admin user can use it.
	# ---------------------------------------------------------------------
	handle /rabbitmq/* {
		reverse_proxy rabbitmq:15672
	}

	# Anything else, including the bare root, is not part of this deployment.
	handle {
		respond "cltl-apps: nothing is served here." 404
	}
}
