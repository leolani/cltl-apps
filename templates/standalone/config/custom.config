# STANDALONE deployment — every module on one machine, one Compose project,
# no tenant.
#
# This file is empty of overrides on purpose: templates/common/default.config
# already describes exactly this deployment. That is the point of the
# standalone role — it is the platform with nothing repointed and nothing
# switched off, and the other two roles are defined by what they override
# relative to it. Compare this file with templates/server/config/custom.config
# and templates/tenant/config/custom.config to see what a role actually is.
#
# Add only the keys you want to change; everything else falls through to
# default.config. The examples below are commented out.

# The chat UI's Image and Monitoring tabs are both ON in default.config.
# Two reasons to change that here:
#
#   - monitoring_url empty drops the Monitoring tab. Do that if you leave
#     modules/monitoring out of your bring-up command, since the tab's iframe
#     would otherwise have nothing to load. Repoint it instead if you moved
#     CLTL_MONITORING_PORT in config/standalone.env — a bare origin, no path,
#     reachable from the browser.
#   - image_upload: False drops the Image tab.
#
# One section, both keys: two `[cltl.chat-ui]` blocks in one file is a
# duplicate-section error, not a merge.
# [cltl.chat-ui]
# monitoring_url:
# image_upload: False

# Example: switch ASR to Google Cloud Speech (requires a service-account key)
# [cltl.asr]
# implementation: google

# [cltl.asr.google]
# language: en-US

# Example: change the Whisper model size (tiny / base / small / medium / large)
# Larger models are more accurate but slower and use more memory.
# [cltl.asr.whisper]
# model: small
# language: en

# Example: tune Voice Activity Detection sensitivity
# activity_threshold: 0.0 (most sensitive) – 1.0 (least sensitive)
# All time values are in milliseconds.
# [cltl.vad.webrtc]
# activity_threshold: 0.6
# activity_window: 300
# allow_gap: 300
# padding: 600

# Example: text-only, with no microphone server on the host. Leaving the mic
# topic empty switches that facet of modules/backend off, making the chat UI
# the sole input channel; run_host_server.sh is then unnecessary.
# [cltl.backend.mic]
# topic:
