# Docker Compose variables for a STANDALONE deployment — every module on one
# machine, one Compose project, no tenant:
#
#   ./modules/backend/run_host_server.sh &   # leoserv; skip for text-only
#   docker compose --env-file config/standalone.env \
#       -f modules/event-bus/docker-compose.yml \
#       -f modules/backend/docker-compose.yml \
#       -f modules/eliza/docker-compose.yml \
#       -f modules/vad-asr/docker-compose.yml \
#       -f modules/emissor/docker-compose.yml \
#       -f modules/context/docker-compose.yml \
#       -f modules/chat-ui/docker-compose.yml \
#       -f modules/monitoring/docker-compose.yml up -d --wait --pull always
#
# Only values Compose itself needs before any container exists belong in
# here: image tags, published ports and bind addresses, the project name.
# Everything the application reads — the tenant, where the event bus and storage
# are, which facets are switched on — lives in config/custom.config instead.
#
# Nothing here is required: every value below is the compose files' own
# default, repeated so it is visible and easy to change. `--env-file` works
# the same with all of it commented out.

# Compose project name, and the name of the Docker network every module
# joins. Change it only to run a second, separate deployment on this same
# machine — then also move every published port below.
# CLTL_PROJECT=cltl-platform

# Pin every image to one tag instead of :latest.
# VERSION=1.0.0

# Published host ports.
# CLTL_BACKEND_PORT=8001      # storage API (and /host when run_server is on)
# CLTL_CHATUI_PORT=8003
# CLTL_MONITORING_PORT=8005
#
# Not configurable here: modules/emissor publishes 8002 and modules/event-bus
# publishes 5672 (AMQP) and 15672 (management UI) on fixed host ports.

# Bind published ports to the loopback interface only, so nothing is
# reachable from outside this machine. Reasonable for a standalone
# deployment, which has no remote tenants to serve.
# CLTL_STORAGE_BIND=127.0.0.1
# CLTL_EMISSOR_BIND=127.0.0.1
# CLTL_RABBITMQ_MGMT_BIND=127.0.0.1
