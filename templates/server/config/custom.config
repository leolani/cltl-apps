# SERVER deployment — the shared, untenanted half of a split deployment:
# modules/broker, modules/backend, modules/eliza, modules/vad-asr,
# modules/emissor (and optionally modules/reverse-proxy). One instance,
# serving every tenant's client.
#
# What makes this a server, relative to templates/common/default.config, is
# only this: the hardware-I/O facet of modules/backend is switched off. The
# storage facet is left exactly as the baseline has it (audio_storage and
# image_storage local, reached by other modules at http://backend:8000), and
# [cltl.event.kombu] tenant stays empty, so every module here binds
# `<topic>.#` and serves all tenants at once. Giving a server a tenant would
# scope it to one tenant's traffic — see doc/DEPLOYMENT.md#tenancy.
#
# Add only the keys you want to change; everything else falls through to
# default.config.

# No microphone, no camera, no speech on a server: those belong to each
# client, next to the person using it. An empty topic is the platform's way
# of saying "this facet is not in this deployment", and it is what keeps one
# cltl-backend container from also acting as a client's audio proxy.
#
# [cltl.backend] server_audio_url/server_image_url are deliberately left at
# their baseline values rather than blanked: with these topics empty they are
# never dialled, and leaving them avoids an empty URL reaching the audio
# source constructor.
[cltl.backend.mic]
topic:

[cltl.backend.image]
topic:

# Switches off text-to-speech. Note this does not stop the TTS consumer
# thread from being created: unlike the microphone and camera paths,
# cltl-backend's BackendService._start_tts does not check whether its topic
# is set, so an empty topic leaves a subscriber bound to a routing key that
# matches nothing. It is inert — the thread simply never receives an event,
# and no audio device is opened — but it is why you will see one idle worker
# in a server's backend logs.
[cltl.backend.tts]
topic:

# Nothing to speak through either, for the same reason.
[cltl.backend.text_output]
remote_url:

# Example: switch ASR to Google Cloud Speech (requires a service-account key)
# ASR runs on the server, so a change here applies to every tenant.
# [cltl.asr]
# implementation: google

# [cltl.asr.google]
# language: en-US

# Example: change the Whisper model size (tiny / base / small / medium / large)
# Larger models are more accurate but slower and use more memory.
# [cltl.asr.whisper]
# model: small
# language: en

# Example: tune Voice Activity Detection sensitivity
# activity_threshold: 0.0 (most sensitive) – 1.0 (least sensitive)
# All time values are in milliseconds.
# [cltl.vad.webrtc]
# activity_threshold: 0.6
# activity_window: 300
# allow_gap: 300
# padding: 600

# Example: when modules/reverse-proxy fronts this deployment, a client
# reaches storage through a path-prefixed HTTPS URL instead of a host port.
# That is configured on the CLIENT side, not here — see
# doc/DEPLOYMENT.md#a-remote-server.
