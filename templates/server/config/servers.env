# Docker Compose variables for this checkout's servers/* stacks.
#
#   docker compose --env-file config/servers.env \
#       -f servers/broker/docker-compose.yml \
#       -f servers/eliza/docker-compose.yml \
#       -f servers/vad-asr/docker-compose.yml \
#       -f servers/emissor/docker-compose.yml up -d --wait --pull always
#
# Nothing here is required — every servers/* image tag already defaults to
# :latest — this file exists so pinning a version is one edit instead of an
# inline env var on every command.

# VERSION=latest

# Only needed when adding servers/reverse-proxy/docker-compose.yml as a 6th
# -f file (see doc/DEPLOYMENT.md) — i.e. this checkout is reachable from the
# public internet, not just a co-located demo. CLTL_HOSTNAME and
# CLTL_ACME_EMAIL are required by caddy; without them it refuses to start.

# CLTL_HOSTNAME=combot.example.org
# CLTL_ACME_EMAIL=you@example.org

# With servers/reverse-proxy fronting storage/emissor/the management UI,
# uncomment these so the raw ports stop being reachable from outside this
# host — everything then goes through caddy on 443 instead.

# CLTL_STORAGE_BIND=127.0.0.1
# CLTL_EMISSOR_BIND=127.0.0.1
# CLTL_RABBITMQ_MGMT_BIND=127.0.0.1
