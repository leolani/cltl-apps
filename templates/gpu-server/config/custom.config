# GPU SERVER deployment — a SERVER (see templates/server) whose speech
# recognition runs on a local GPU, plus a local LLM: modules/whisper and
# modules/ollama on top of the server's modules. See
# doc/DEPLOYMENT.md#a-gpu-server.
#
# This replaces templates/server/config/custom.config rather than adding to it
# (a checkout has one custom.config): everything below the ASR and LLM
# sections is that file's server delta, unchanged.
#
#   cp templates/common/config/* templates/server/config/* \
#      templates/gpu-server/config/* config/
#
# The model names below are fixed by what the server runs — the file
# modules/whisper loads and the model pulled into modules/ollama — so change
# them only together with that (CLTL_WHISPER_MODEL in config/gpu-server.env,
# `ollama pull`).

# ASR sends each speech segment to modules/whisper over the Docker network,
# instead of running openai-whisper on the CPU inside the cltl-asr container.
# Needs a cltl-asr image that knows whisper_cpp; an older one fails at start
# with "Unsupported implementation whisper_cpp".
[cltl.asr]
implementation: whisper_cpp

# model only labels the transcriptions: whisper-server transcribes with the
# file it was started with. timeout is seconds per segment.
[cltl.asr.whisper_cpp]
url: http://whisper:8080/inference
model: large-v3-turbo
language: en
timeout: 60

# Where modules/ollama answers, for a module of yours on this server. No
# module of the platform reads this section: the agent's dialogue is ELIZA,
# which uses no LLM. A tenant's module reaches the same server at
# https://<host>/ollama/ with the Basic Auth credential instead. The model is
# a vision model: messages may carry images.
[cltl.llm.ollama]
url: http://ollama:11434
model: qwen3-vl:8b-instruct-q4_K_M

# No microphone, no camera, no speech on a server: those belong to each
# tenant, next to the person using it. An empty topic is the platform's way
# of saying "this facet is not in this deployment", and it is what keeps one
# cltl-backend container from also acting as a tenant's audio proxy.
#
# [cltl.backend] server_audio_url/server_image_url are deliberately left at
# their baseline values rather than blanked: with these topics empty they are
# never dialled, and leaving them avoids an empty URL reaching the audio
# source constructor.
[cltl.backend.mic]
topic:

# rate as well as topic: with a rate set, the container builds a camera and
# opens a session against server_image_url even though no thread records from
# it. Both at nothing is what actually means "no camera here".
[cltl.backend.image]
topic:
rate: 0

# Switches off text-to-speech. Note this does not stop the TTS consumer
# thread from being created: unlike the microphone and camera paths,
# cltl-backend's BackendService._start_tts does not check whether its topic
# is set, so an empty topic leaves a subscriber bound to a routing key that
# matches nothing. It is inert — the thread simply never receives an event,
# and no audio device is opened — but it is why you will see one idle worker
# in a server's backend logs.
[cltl.backend.tts]
topic:

# Nothing to speak through either, for the same reason.
[cltl.backend.text_output]
remote_url:

# Example: send ELIZA's replies to their own topic instead of
# cltl.topic.text_out, which the chat UI, text-to-speech, monitoring and the
# EMISSOR recorder listen on, so that a tenant's own module can answer in its
# place. A tenant then sees ELIZA only by also listening to eliza_out — see
# doc/GETTING-STARTED.md, scenario B, which assumes the course server does this.
# [cltl.eliza]
# topic_output: cltl.topic.eliza_out

# Example: tune Voice Activity Detection sensitivity
# activity_threshold: 0.0 (most sensitive) – 1.0 (least sensitive)
# All time values are in milliseconds.
# [cltl.vad.webrtc]
# activity_threshold: 0.6
# activity_window: 300
# allow_gap: 300
# padding: 600

# Example: when modules/reverse-proxy fronts this deployment, a tenant
# reaches storage through a path-prefixed HTTPS URL instead of a host port.
# That is configured on the TENANT side, not here — see
# doc/DEPLOYMENT.md#a-remote-server.
