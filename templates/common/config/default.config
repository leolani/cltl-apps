# The platform's config baseline, shared by EVERY deployment regardless of
# role. Copy it, together with logging.config, into a checkout's own top-level
# config/ along with one role's custom.config — see doc/DEPLOYMENT.md.
#
# Every module in a checkout bind-mounts this file read-only, so a
# platform-wide default (a topic name, an ASR model) is changed here once.
# Nothing role-specific belongs in here: what makes a deployment a server, a
# tenant or a standalone is the ~6 keys its custom.config overrides, and
# keeping them there is what lets this file stay a single copy.
#
# The values below describe a STANDALONE deployment — every module on one
# machine, in one Compose project, with no tenant:
#
#   - the event bus and the storage API are reached by Compose service-name DNS
#     (rabbitmq, backend), which resolves because all modules share one
#     network;
#   - [cltl.backend] holds the store itself (audio_storage/image_storage
#     local) AND proxies this machine's microphone/camera server, because one
#     cltl-backend container runs both facets;
#   - [cltl.event.kombu] tenant is empty, so every module publishes on a bare
#     routing key and binds `<topic>.#`, which matches it.
#
# host.docker.internal below always means the machine this container runs on
# (where leoserv, the microphone/camera server, listens) — never the Leolani
# server. A tenant deployment's custom.config repoints the event bus and storage
# at its server while leaving these alone, which is why the distinction
# matters.

[cltl.audio]
sampling_rate: 16000
channels: 1
sample_depth: 2
frame_size: 480

audio_resource: cltl.backend.resource.audio
mic_resource: cltl.backend.resource.microphone

[cltl.video]
resolution: VGA
camera_index: 0

[cltl.backend]
run_server: False
server_image_url: http://host.docker.internal:8000
server_audio_url: http://host.docker.internal:8000
storage_url: http://backend:8000/storage/
audio_storage: local
audio_storage_path: ./storage/audio
audio_source_buffer: 16
image_storage: local
image_storage_path: ./storage/image
image_cache: 32
scenario_topic: cltl.topic.scenario

[cltl.backend.remote_storage]
storage_url: http://backend:8000/storage
upload_timeout: 30

[cltl.backend.mic]
topic: cltl.topic.microphone

[cltl.backend.image]
topic:
rate: 0

[cltl.backend.tts]
topic: cltl.topic.text_out

[cltl.backend.text_output]
remote_url: http://host.docker.internal:8000
remote_type: sound

[cltl.chat-ui]
name: chat-ui
agent_id: leolani
external_input: True
timeout: 0

# The column beside the conversation is a tab strip, and both of its tabs are
# switched on in this baseline. GET /chatui/config tells the page which ones
# the deployment offers: a tab whose key is off is left out, and a single
# remaining tab loses the strip.

# The Image tab: upload a picture, drag labelled rectangles over it, submit.
# Submitting PUTs the pixels to image_storage_url and publishes ONE
# ImageSignalEvent on [cltl.chat-ui.events] topic_image below, carrying a
# region per rectangle inside the signal. It publishes nothing on
# topic_utterance, so the agent does not answer a picture — the image is
# echoed into the transcript and recorded, and that is all.
#
# Requires external_input: True above. With it False, get_utterances defaults
# its speaker filter to the agent, which filters the echo straight back out of
# the transcript and makes a successful upload look like it did nothing.
image_upload: True
image_cache: 4
image_max_size: 10485760
image_types: image/png, image/jpeg, image/gif, image/webp
# Where the pixels are PUT, so that the `cltl-storage:image/<id>` reference in
# the published signal resolves for everyone. Empty on purpose: it falls back
# to [cltl.backend] storage_url above, which is the value cltl-emissor-data
# and cltl-monitoring resolve that same reference against. One value to keep
# right instead of three — and a tenant's custom.config repoints storage_url
# at the server, which this then follows for free.
image_storage_url:
image_upload_timeout: 30

# The Monitoring tab: an iframe onto modules/monitoring's page, showing what
# the platform perceived in this chat's scenario. A bare origin, no path (the
# chat UI frontend appends /static/monitoring.html itself), reachable from the
# BROWSER — hence localhost, never a Compose service name and never the
# server's host.
#
# 8005 is CLTL_MONITORING_PORT's default in both roles that run a chat UI, so
# this value is right for a standalone deployment and for a single tenant.
# Override it in this checkout's own config/custom.config if you moved that
# port (a second tenant on one machine must), and set it empty there if you do
# not run modules/monitoring — the tab is then left out, which is better than
# a tab whose iframe cannot load.
monitoring_url: http://localhost:8005

[cltl.chat-ui.events]
local: True
topic_utterance: cltl.topic.text_in
topic_response: cltl.topic.text_out
topic_scenario : cltl.topic.scenario
# Where a submitted image is published. [cltl.monitoring] topic_image and
# [cltl.emissor-data.event] topics below both subscribe to it.
# [cltl.backend.image] topic above is a different thing — the host camera,
# which this baseline leaves off.
topic_image: cltl.topic.image

[cltl.intentions.init]
topic_scenario: cltl.topic.scenario
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_text_in: cltl.topic.text_in
topic_text_out: cltl.topic.text_out
topic_face:
greeting: Do you want to talk to me?

[cltl.bdi]
topic_scenario: cltl.topic.scenario
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
model: {"init":
             {"initialized": ["eliza"]},
         "eliza":
             {"quit": ["init"]}
         }

[cltl.context]
topic_scenario: cltl.topic.scenario
topic_speaker: cltl.topic.scenario_speaker
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_knowledge:
start_scenario: true

[cltl.vad]
implementation:
mic_topic: cltl.topic.microphone
vad_topic: cltl.topic.vad

[cltl.vad.webrtc]
activity_window: 300
activity_threshold: 0.8
allow_gap: 300
padding: 600

[cltl.asr]
implementation: whisper
sampling_rate: 16000
vad_topic: cltl.topic.vad
asr_topic: cltl.topic.text_in

[cltl.asr.google]
sampling_rate: 16000
language: en-GB
hints:

[cltl.asr.whisper]
model: base
language: en

[cltl.asr.wav2vec]
model: jonatasgrosman/wav2vec2-large-xlsr-53-english

[cltl.asr.speechbrain]
model: speechbrain/asr-wav2vec2-commonvoice-en

[cltl.eliza]
language: en
topic_input : cltl.topic.text_in
topic_output : cltl.topic.text_out

[cltl.keyword]
intentions: eliza
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_text_in: cltl.topic.text_in
topic_text_out: cltl.topic.text_out

[eliza.context]
topic_scenario: cltl.topic.scenario
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire

[cltl.event]
implementation: kombu
log_dir: ./storage/event_log

[cltl.event.kombu]
server: amqp://eliza:eliza123@rabbitmq:5672/
exchange: cltl.combot
compression: bzip2
tenant:

[cltl.monitoring]
topic_scenario: cltl.topic.scenario
topic_image: cltl.topic.image
topic_text_in: cltl.topic.text_in
topic_text_out: cltl.topic.text_out
# Annotations published by object/face recognition — neither is part of this
# platform's module set. Empty means the topic is not subscribed at all,
# which is the platform's idiom for "not in this deployment", not an error.
topic_object:
topic_vector_id:
# Record every scenario whether or not anything is polling. The component's
# own default of 15 (seconds since the page last asked) suits a camera-fed
# deployment, but not this one: the Monitoring tab shares a tab strip with the
# Image tab, so while a person annotates an image the Monitoring tab is
# hidden, nothing polls, and the image they submit would be dropped on arrival
# with no replay — leaving the tab blank when they switch to it.
active_interval: 0
scenario_cache: 4

[cltl.emissor-data]
path: ./storage/emissor

[cltl.emissor-data.event]
topics: cltl.topic.scenario,
        cltl.topic.image, cltl.topic.microphone,
        cltl.topic.text_in, cltl.topic.text_out,
        cltl.topic.vad,
        cltl.desire, cltl.intention

[environment]
GOOGLE_APPLICATION_CREDENTIALS: config/google_cloud_key.json
