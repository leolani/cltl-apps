# What makes this checkout one tenant. $CLTL_TENANT (config/clients.env) is
# required by every clients/*/docker-compose.yml before its container even
# starts — see doc/DEPLOYMENT.md#tenancy.
[cltl.event.kombu]
tenant: $CLTL_TENANT

# Overrides default.config's [cltl.chat-ui] monitoring_url (empty there).
# $CLTL_MONITORING_URL is set on clients/chat-ui/docker-compose.yml from
# config/clients.env, defaulting to empty. Only clients/chat-ui reads this
# section; it's harmless for the other three services to also see it, same
# as any shared config value.
[cltl.chat-ui]
monitoring_url: $CLTL_MONITORING_URL
