# Docker Compose variables for this checkout's clients/* stacks: backend,
# context, chat-ui and monitoring.
#
#   docker compose --env-file config/clients.env \
#       -f clients/backend/docker-compose.yml \
#       -f clients/context/docker-compose.yml \
#       -f clients/chat-ui/docker-compose.yml \
#       -f clients/monitoring/docker-compose.yml up -d --wait --pull always
#
# Running a second tenant means a second checkout of this repo, configured
# from this same template with its own values below — see
# doc/DEPLOYMENT.md#tenancy.

CLTL_TENANT=tenant-a
CLTL_BACKEND_PORT=9001
CLTL_CHATUI_PORT=8003

# clients/monitoring's published port. Drop `-f clients/monitoring/...` from
# the command above (and comment out CLTL_MONITORING_URL below) if you don't
# want it running at all.
CLTL_MONITORING_PORT=8005

# Shows clients/chat-ui's Monitoring tab, pointed at clients/monitoring above
# (bare origin, no path — the chat UI frontend appends /static/monitoring.html
# itself). Keep the port here in sync with CLTL_MONITORING_PORT by hand —
# Compose env files don't expand other variables within themselves. Comment
# this out (rather than leaving it pointed at a port nothing is listening on)
# if you drop clients/monitoring from the command above — an empty/unset
# value leaves the tab out, which is safer than one whose iframe can't load.
CLTL_MONITORING_URL=http://localhost:8005

# Where this client reaches the Leolani server's published AMQP (5672) and
# storage (8001) ports. host.docker.internal is correct when servers/* runs
# on this same machine (in its own, separate checkout — see
# doc/DEPLOYMENT.md); set it to the server's real reachable hostname/IP for a
# remote server. This is NOT the host running this client's own
# microphone/camera server (leoserv) — that is always host.docker.internal,
# since it is literally this machine, regardless of where the Leolani server
# is (see [cltl.backend] server_image_url/server_audio_url in
# config/default.config).
CLTL_SERVER_HOST=host.docker.internal

# Optional: pin every clients/* image tag; leave commented to use :latest.
# VERSION=latest
