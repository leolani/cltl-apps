# Config baseline for a CLIENT checkout (clients/backend, clients/context,
# clients/chat-ui, clients/monitoring — one tenant). Copied from
# templates/client/config/ into this checkout's own top-level config/ — see
# doc/DEPLOYMENT.md. Every clients/* stack in this checkout bind-mounts THIS
# file read-only, so a topic or platform-wide default only needs to be
# changed here once.
#
# [cltl.backend] below is the CLIENT proxy role: it has no store of its own,
# it proxies the host's microphone/camera server (leoserv) instead of
# holding the store servers/eliza does.
#
# $CLTL_SERVER_HOST (config/clients.env) is where this client reaches the
# Leolani server's published AMQP (5672) and storage (8001) ports —
# host.docker.internal by default (co-located, a separate checkout on this
# same machine), or the server's real reachable address for a remote server.
# It is a DIFFERENT host from the literal host.docker.internal used below for
# server_image_url/server_audio_url/text_output.remote_url — those always
# mean this client's OWN machine (its microphone/camera server), never the
# Leolani server, regardless of where CLTL_SERVER_HOST points.
#
# [cltl.event.kombu] tenant is left blank here — it is set in this
# checkout's own config/custom.config via $CLTL_TENANT. See
# doc/DEPLOYMENT.md#tenancy.

[cltl.audio]
sampling_rate: 16000
channels: 1
sample_depth: 2
frame_size: 480

audio_resource: cltl.backend.resource.audio
mic_resource: cltl.backend.resource.microphone

[cltl.video]
resolution: VGA
camera_index: 0

[cltl.backend]
run_server: False
server_image_url: http://host.docker.internal:8000
server_audio_url: http://host.docker.internal:8000
storage_url: http://$CLTL_SERVER_HOST:8001/storage/
audio_storage: remote
audio_storage_path: ./storage/audio
audio_source_buffer: 16
image_storage: remote
image_storage_path: ./storage/image
image_cache: 32
scenario_topic: cltl.topic.scenario

[cltl.backend.remote_storage]
storage_url: http://$CLTL_SERVER_HOST:8001/storage
upload_timeout: 30

[cltl.backend.mic]
topic: cltl.topic.microphone

[cltl.backend.image]
topic:
rate: 0

[cltl.backend.tts]
topic: cltl.topic.text_out

[cltl.backend.text_output]
remote_url: http://host.docker.internal:8000
remote_type: sound

[cltl.chat-ui]
name: chat-ui
agent_id: leolani
external_input: True
timeout: 0
# The Monitoring tab: an iframe onto clients/monitoring's page, if that
# optional stack is running for this tenant. Set in this checkout's own
# config/custom.config (bare origin, no path). Empty leaves the tab out.
monitoring_url:

[cltl.chat-ui.events]
local: True
topic_utterance: cltl.topic.text_in
topic_response: cltl.topic.text_out
topic_scenario : cltl.topic.scenario

[cltl.intentions.init]
topic_scenario: cltl.topic.scenario
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_text_in: cltl.topic.text_in
topic_text_out: cltl.topic.text_out
topic_face:
greeting: Do you want to talk to me?

[cltl.bdi]
topic_scenario: cltl.topic.scenario
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
model: {"init":
             {"initialized": ["eliza"]},
         "eliza":
             {"quit": ["init"]}
         }

[cltl.context]
topic_scenario: cltl.topic.scenario
topic_speaker: cltl.topic.scenario_speaker
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_knowledge:
start_scenario: true

[cltl.vad]
implementation:
mic_topic: cltl.topic.microphone
vad_topic: cltl.topic.vad

[cltl.vad.webrtc]
activity_window: 300
activity_threshold: 0.8
allow_gap: 300
padding: 600

[cltl.asr]
implementation: whisper
sampling_rate: 16000
vad_topic: cltl.topic.vad
asr_topic: cltl.topic.text_in

[cltl.asr.google]
sampling_rate: 16000
language: en-GB
hints:

[cltl.asr.whisper]
model: base
language: en

[cltl.asr.wav2vec]
model: jonatasgrosman/wav2vec2-large-xlsr-53-english

[cltl.asr.speechbrain]
model: speechbrain/asr-wav2vec2-commonvoice-en

[cltl.eliza]
language: en
topic_input : cltl.topic.text_in
topic_output : cltl.topic.text_out

[cltl.keyword]
intentions: eliza
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire
topic_text_in: cltl.topic.text_in
topic_text_out: cltl.topic.text_out

[eliza.context]
topic_scenario: cltl.topic.scenario
topic_intention: cltl.topic.intention
topic_desire: cltl.topic.desire

[cltl.event]
implementation: kombu
log_dir: ./storage/event_log

[cltl.event.kombu]
server: amqp://eliza:eliza123@$CLTL_SERVER_HOST:5672/
exchange: cltl.combot
compression: bzip2
tenant:

[cltl.monitoring]
topic_scenario: cltl.topic.scenario
topic_image: cltl.topic.image
topic_text_in: cltl.topic.text_in
topic_text_out: cltl.topic.text_out
# Annotations published by object/face recognition — neither runs in this
# deployment. Empty means the topic is not subscribed at all, not an error.
topic_object:
topic_vector_id:
active_interval: 15
scenario_cache: 4

[cltl.emissor-data]
path: ./storage/emissor

[cltl.emissor-data.event]
topics: cltl.topic.scenario,
        cltl.topic.image, cltl.topic.microphone,
        cltl.topic.text_in, cltl.topic.text_out,
        cltl.topic.vad,
        cltl.desire, cltl.intention

[environment]
GOOGLE_APPLICATION_CREDENTIALS: config/google_cloud_key.json
