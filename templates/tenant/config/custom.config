# TENANT deployment — one tenant's user-facing half: modules/backend,
# modules/context, modules/chat-ui and optionally modules/monitoring. One
# instance per tenant, each its own checkout.
#
# What makes this a tenant, relative to templates/common/default.config, is
# only this: the event bus and the storage API are repointed from this project's
# own services at the server's published ports, storage becomes remote rather
# than local, and a tenant id is set. The hardware-I/O facet of
# modules/backend is left exactly as the baseline has it — proxying this
# machine's microphone/camera server.
#
# SERVER_HOST below: host.docker.internal is correct when the server
# deployment runs on this same machine as a separate checkout. For a server
# on another machine, replace it in all four places with that machine's
# reachable hostname or IP, and make sure ports 5672 (AMQP) and 8001
# (storage) are reachable from here. See doc/DEPLOYMENT.md#a-remote-server,
# which also covers a server fronted by modules/reverse-proxy, where a
# path-prefixed HTTPS URL replaces host and port entirely.
#
# Do NOT change server_audio_url/server_image_url/text_output remote_url in
# default.config to match: those mean this tenant's OWN machine, where
# leoserv listens, and stay host.docker.internal however far away the server
# is.

# What makes this checkout one tenant. One lowercase routing-key word
# (^[a-z0-9][a-z0-9_-]*$). Every module in this checkout then binds
# `<topic>.<tenant>` and hears only this tenant's traffic, while the shared,
# untenanted server modules bind `<topic>.#` and hear everyone. Leaving it
# empty is valid but means something specific — an untenanted deployment, whose
# bare publishes a tenanted subscriber will never receive — so set it unless
# you are deliberately running a standalone deployment instead. See
# doc/DEPLOYMENT.md#tenancy.
[cltl.event.kombu]
tenant: tenant-a
server: amqp://eliza:eliza123@host.docker.internal:5672/

# Storage lives on the server, so this tenant forwards to it rather than
# holding a store of its own. The port is the server's published
# CLTL_BACKEND_PORT (8001 by default).
[cltl.backend]
storage_url: http://host.docker.internal:8001/storage/
audio_storage: remote
image_storage: remote

[cltl.backend.remote_storage]
storage_url: http://host.docker.internal:8001/storage

# The chat UI's Image and Monitoring tabs are both ON in default.config, and
# its monitoring_url (http://localhost:8005) matches CLTL_MONITORING_PORT in
# config/tenant.env. Three reasons to change that here:
#
#   - a SECOND tenant on this machine must move CLTL_MONITORING_PORT, and
#     must then repoint monitoring_url to the same port. Nothing links the
#     two: config files and env files do not expand each other.
#   - monitoring_url empty drops the Monitoring tab. Do that if you leave
#     modules/monitoring out of your bring-up command, since the tab's iframe
#     would otherwise have nothing to load.
#   - image_upload: False drops the Image tab. Leaving it on is safe on a
#     tenant: [cltl.backend] storage_url above repoints the upload at the
#     server along with everything else stored there.
#
# Whichever you need, the URL stays localhost — the BROWSER dials it, so it is
# never a Compose service name and never the server's host.
#
# One section, both keys: two `[cltl.chat-ui]` blocks in one file is a
# duplicate-section error, not a merge.
# [cltl.chat-ui]
# monitoring_url:
# image_upload: False

# Example: text-only, with no microphone/camera server on the host. Both
# facets have to go: an empty mic topic makes the chat UI the sole input
# channel, and the camera needs its rate cleared as well as its topic, or it
# keeps dialling a host server that is not there. run_host_server.sh is then
# unnecessary.
# [cltl.backend.mic]
# topic:
#
# [cltl.backend.image]
# topic:
# rate: 0
