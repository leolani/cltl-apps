# ============================================================
# CONFIGURE ME — Client connection to the server
# ============================================================
#
# The client stack connects to the server only through two exposed host ports:
#   - RabbitMQ AMQP on TCP 5672
#   - Storage REST API on TCP 8001
#
# Same machine (default):
#   host.docker.internal resolves from inside each client container to the
#   Docker host. On Linux this is provided by the extra_hosts entry in
#   docker-compose.client.yml; on macOS/Windows Docker Desktop it works
#   automatically. No change needed here.
#
# Different machines:
#   Replace "host.docker.internal" with the server machine's IP address or
#   hostname (e.g. 192.168.1.100 or eliza-server.local).
#   Make sure TCP ports 5672 and 8001 are reachable from the client machine
#   (adjust the server's firewall rules if necessary).
#
# Example for a remote server at 192.168.1.100:
#   server: amqp://eliza:eliza123@192.168.1.100:5672/
#   storage_url: http://192.168.1.100:8001/storage

[cltl.event.kombu]
server: amqp://eliza:eliza123@host.docker.internal:5672/

[cltl.backend.remote_storage]
storage_url: http://host.docker.internal:8001/storage

[cltl.backend.mic]
topic: cltl.topic.microphone

[cltl.backend.text_output]
remote_url: http://host.docker.internal:8000
remote_type: sound